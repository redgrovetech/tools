{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/redgrovetech/tools/blob/main/schema/device-record.v1.schema.json",
  "title": "Device record v1",
  "description": "The JSON every tool writes. One record per tool run; records link to the same device through device.id.",
  "type": "object",
  "required": [
    "schemaVersion",
    "recordId",
    "device",
    "tool",
    "run",
    "kind",
    "payload"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "recordId": {
      "type": "string",
      "format": "uuid",
      "description": "Unique per run, generated by the tool."
    },
    "device": {
      "$ref": "#/$defs/deviceIdentity"
    },
    "tool": {
      "type": "object",
      "required": [
        "name",
        "version",
        "os",
        "arch"
      ],
      "properties": {
        "name": {
          "type": "string",
          "examples": [
            "specs",
            "erase",
            "tpm"
          ]
        },
        "version": {
          "type": "string"
        },
        "os": {
          "enum": [
            "linux",
            "windows",
            "macos"
          ]
        },
        "arch": {
          "enum": [
            "x64",
            "arm64"
          ]
        },
        "bootEnv": {
          "enum": [
            "usb-live",
            "pxe",
            "installed-os"
          ],
          "description": "How the tool was started."
        }
      }
    },
    "run": {
      "type": "object",
      "required": [
        "startedAt",
        "finishedAt",
        "status"
      ],
      "properties": {
        "startedAt": {
          "type": "string",
          "format": "date-time"
        },
        "finishedAt": {
          "type": "string",
          "format": "date-time"
        },
        "status": {
          "enum": [
            "pass",
            "fail",
            "warning",
            "error"
          ],
          "description": "fail = the device failed; error = the tool could not finish."
        },
        "operator": {
          "type": "string",
          "description": "Technician name or ID, when known."
        },
        "station": {
          "type": "string",
          "description": "Bench or PXE station ID."
        },
        "messages": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "kind": {
      "enum": [
        "specs",
        "erase"
      ]
    },
    "payload": {
      "type": "object"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "specs"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/specsPayload"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "erase"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/erasePayload"
          }
        }
      }
    }
  ],
  "$defs": {
    "deviceIdentity": {
      "type": "object",
      "required": [
        "id"
      ],
      "description": "Stable identity used to link every record for one machine.",
      "properties": {
        "id": {
          "type": "string",
          "description": "sha256 of lowercase 'manufacturer|serialNumber|systemUuid'; falls back to the first fixed disk serial when the board reports none."
        },
        "serialNumber": {
          "type": "string"
        },
        "systemUuid": {
          "type": "string"
        },
        "manufacturer": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "sku": {
          "type": "string"
        },
        "chassisType": {
          "type": "string",
          "examples": [
            "Notebook",
            "Desktop",
            "Mini PC",
            "Server"
          ]
        },
        "assetTag": {
          "type": "string",
          "description": "Our inventory tag, when scanned or typed in."
        }
      }
    },
    "specsPayload": {
      "type": "object",
      "description": "Mirrors systeminformation output, trimmed to what refurbishment needs. Unknown values are omitted, never guessed.",
      "properties": {
        "bios": {
          "type": "object",
          "properties": {
            "vendor": {
              "type": "string"
            },
            "version": {
              "type": "string"
            },
            "releaseDate": {
              "type": "string"
            }
          }
        },
        "baseboard": {
          "type": "object",
          "properties": {
            "manufacturer": {
              "type": "string"
            },
            "model": {
              "type": "string"
            },
            "serial": {
              "type": "string"
            }
          }
        },
        "cpu": {
          "type": "object",
          "properties": {
            "manufacturer": {
              "type": "string"
            },
            "brand": {
              "type": "string"
            },
            "cores": {
              "type": "integer"
            },
            "physicalCores": {
              "type": "integer"
            },
            "speedGHz": {
              "type": "number"
            },
            "arch": {
              "type": "string"
            }
          }
        },
        "memory": {
          "type": "object",
          "properties": {
            "totalBytes": {
              "type": "integer"
            },
            "modules": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "slot": {
                    "type": "string"
                  },
                  "sizeBytes": {
                    "type": "integer"
                  },
                  "type": {
                    "type": "string"
                  },
                  "speedMHz": {
                    "type": "integer"
                  },
                  "manufacturer": {
                    "type": "string"
                  },
                  "partNumber": {
                    "type": "string"
                  },
                  "serial": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "disks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/drive"
          }
        },
        "graphics": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "vendor": {
                "type": "string"
              },
              "model": {
                "type": "string"
              },
              "vramMB": {
                "type": "integer"
              }
            }
          }
        },
        "display": {
          "type": "object",
          "properties": {
            "resolutionX": {
              "type": "integer"
            },
            "resolutionY": {
              "type": "integer"
            },
            "sizeInches": {
              "type": "number"
            }
          }
        },
        "battery": {
          "type": "object",
          "properties": {
            "present": {
              "type": "boolean"
            },
            "designCapacityWh": {
              "type": "number"
            },
            "fullChargeCapacityWh": {
              "type": "number"
            },
            "healthPercent": {
              "type": "number"
            },
            "cycleCount": {
              "type": "integer"
            }
          }
        },
        "network": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "type": {
                "enum": [
                  "wired",
                  "wireless",
                  "other"
                ]
              },
              "mac": {
                "type": "string"
              }
            }
          }
        },
        "os": {
          "type": "object",
          "properties": {
            "platform": {
              "type": "string"
            },
            "distro": {
              "type": "string"
            },
            "release": {
              "type": "string"
            }
          }
        }
      }
    },
    "drive": {
      "type": "object",
      "required": [
        "serial"
      ],
      "properties": {
        "path": {
          "type": "string",
          "description": "OS device path, e.g. /dev/nvme0n1 or \\\\.\\PhysicalDrive0."
        },
        "model": {
          "type": "string"
        },
        "serial": {
          "type": "string"
        },
        "firmware": {
          "type": "string"
        },
        "interface": {
          "enum": [
            "sata",
            "nvme",
            "sas",
            "usb",
            "emmc",
            "other"
          ]
        },
        "mediaType": {
          "enum": [
            "hdd",
            "ssd"
          ]
        },
        "capacityBytes": {
          "type": "integer"
        },
        "smartStatus": {
          "enum": [
            "ok",
            "warning",
            "failing",
            "unknown"
          ]
        },
        "powerOnHours": {
          "type": "integer"
        }
      }
    },
    "erasePayload": {
      "type": "object",
      "required": [
        "drives"
      ],
      "properties": {
        "standard": {
          "type": "string",
          "examples": [
            "NIST SP 800-88 Rev. 1"
          ]
        },
        "drives": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "drive",
              "method",
              "result"
            ],
            "properties": {
              "drive": {
                "$ref": "#/$defs/drive"
              },
              "sanitizationLevel": {
                "enum": [
                  "clear",
                  "purge"
                ]
              },
              "method": {
                "enum": [
                  "overwrite",
                  "ata-secure-erase",
                  "ata-enhanced-secure-erase",
                  "nvme-format-user-data",
                  "nvme-format-crypto",
                  "nvme-sanitize-block",
                  "nvme-sanitize-crypto",
                  "nvme-sanitize-overwrite"
                ]
              },
              "passes": {
                "type": "integer",
                "minimum": 1
              },
              "pattern": {
                "type": "string",
                "examples": [
                  "zeros",
                  "random"
                ]
              },
              "startedAt": {
                "type": "string",
                "format": "date-time"
              },
              "finishedAt": {
                "type": "string",
                "format": "date-time"
              },
              "verification": {
                "type": "object",
                "properties": {
                  "method": {
                    "enum": [
                      "full-read",
                      "sample"
                    ]
                  },
                  "sampledPercent": {
                    "type": "number"
                  },
                  "result": {
                    "enum": [
                      "pass",
                      "fail"
                    ]
                  }
                }
              },
              "hiddenAreas": {
                "type": "object",
                "description": "HPA/DCO found and removed before erasing.",
                "properties": {
                  "hpaRemoved": {
                    "type": "boolean"
                  },
                  "dcoRemoved": {
                    "type": "boolean"
                  }
                }
              },
              "result": {
                "enum": [
                  "erased",
                  "failed",
                  "skipped"
                ]
              },
              "error": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
